#!/bin/sh
# Refuse a merge commit on `main`.
#
# `main` takes one squashed commit per promotion (see hooks/pre-commit). A
# clean `git merge dev` on `main` creates its commit without running
# pre-commit, so this hook is what stops it locally; GitHub's linear-history
# rule would only refuse it at push time. A fast-forward makes no commit and
# runs no hook: `dev` never fast-forwards onto `main` once a promotion has
# happened, and the push rule still catches it.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
	cat >&2 <<'MSG'
refusing a merge commit on `main`; it takes one squashed commit per promotion.

  git merge --abort
  git merge --squash dev && git commit

Override for a genuine exception with: git merge --no-verify
MSG
	exit 1
fi
