# Copy to `.env` at the repo root (both `.env` and `src/.env` are gitignored;
# if both exist, keep them in step — `settings.load_environment` stops at the
# first one it finds, walking up from the working directory and then from the
# package, each walk stopping at its project root).

# The key for whichever provider `pipeline.yaml` names (default: openai).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Where generated atoms live. Absolute, so `universe_builder` runs from any
# directory. Without it, data resolves to
# ./data/automated under the working directory (see settings.data_dir).
UNIVERSE_BUILDER_DATA_DIR=/absolute/path/to/your/data/automated
